{
  "version": 2,
  "description": "AgentDojo workspace 的 NeonForge 策略门预设（v2）。deny > ask > allow；ask 在无人类审批的基准中按 fail-closed 拒绝；NF_GATE_APPROVAL_URL 可接审批回调。",
  "groups": {
    "readOnly": [
      "get_unread_emails",
      "get_sent_emails",
      "get_received_emails",
      "get_draft_emails",
      "search_emails",
      "search_contacts_by_name",
      "search_contacts_by_email",
      "get_current_day",
      "search_calendar_events",
      "get_day_calendar_events",
      "search_files_by_filename",
      "get_file_by_id",
      "list_files",
      "search_files"
    ],
    "localCreate": ["create_file"],
    "localEdit": ["append_to_file"],
    "localCalendar": ["create_calendar_event"],
    "external": [
      "send_email",
      "share_file",
      "add_calendar_event_participants",
      "reschedule_calendar_event",
      "cancel_calendar_event"
    ],
    "destructive": ["delete_email", "delete_file"]
  },
  "modes": {
    "strict": ["readOnly"],
    "standard": ["readOnly", "localCreate", "localCalendar"],
    "delegated": ["readOnly", "localCreate", "localEdit", "localCalendar"]
  },
  "rules": [
    { "action": "deny", "tool": "delete_email", "specifier": "" },
    { "action": "deny", "tool": "delete_file", "specifier": "" },
    { "action": "ask", "tool": "send_email", "specifier": "" },
    { "action": "ask", "tool": "share_file", "specifier": "" },
    { "action": "ask", "tool": "add_calendar_event_participants", "specifier": "" },
    { "action": "ask", "tool": "reschedule_calendar_event", "specifier": "" },
    { "action": "ask", "tool": "cancel_calendar_event", "specifier": "" },
    { "action": "deny", "tool": "create_file", "specifier": "secret-" }
  ]
}
